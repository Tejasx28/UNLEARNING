    "verify": "node scripts/verify.mjs",
    "start": "node scripts/start-demo.mjs"
  },
  "dependencies": {
    "framer-motion": "^12.23.24",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.0"
  }
}
