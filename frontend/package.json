{
  "name": "ske-llm-console",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/prepare-app.mjs && vite --host 127.0.0.1 --configLoader native",
    "build": "node scripts/prepare-app.mjs && tsc --noEmit && vite build --configLoader native && node scripts/publish-build.mjs",
